# Copy this file to .env.local and fill in real values. Never commit .env.local.

NODE_ENV=development

# MongoDB must be a replica set (even a single-node one) — the app uses
# multi-document transactions for every financially-sensitive write, which
# a standalone mongod does not support.
# Local dev: `mongod --replSet rs0` then `mongosh --eval "rs.initiate()"`,
# or use MongoDB Atlas (all Atlas clusters are replica sets by default).
MONGODB_URI=mongodb://localhost:27017/garment-erp?replicaSet=rs0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_WINDOW=5

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# SMTP for OTP email delivery. If left unset in development, OTP codes are
# logged to the server console instead of emailed. Unset in production is
# a hard error (registration/login will fail) — never faked.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NEXORA <no-reply@example.com>"
